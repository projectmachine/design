# Coolify deploys this stack from deploy/docker-compose.yml.
# It generates the public app URL from SERVICE_FQDN_OPENDESIGN_7456 and routes
# traffic to container port 7456 through its proxy.

# Hosted deployments use Supabase/Postgres. DATABASE_URL should be the Supabase
# connection-pooler URL. Keep the service role key server-only; only
# NEXT_PUBLIC_* values are embedded in the static web client.
OD_DAEMON_DB=postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Container memory limit. Raise this for large exports, concurrent agent runs,
# or heavy upload workflows.
OPEN_DESIGN_MEM_LIMIT=384m

# Node.js heap cap inside the container.
NODE_OPTIONS=--max-old-space-size=192

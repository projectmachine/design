{
  "name": "open-design",
  "version": "0.7.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "Web-only Open Design fork: serves the Next.js frontend and a stripped Express API.",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "guard": "tsx ./scripts/guard.ts && node --import tsx --test scripts/style-policy.test.ts",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck && tsc -p scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "4.21.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
